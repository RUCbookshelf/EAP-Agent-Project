# Copy this file to .env and fill in values locally. Never commit .env.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///data/writing_feedback.db
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_PROVIDER=deepseek
# Live integration tests are opt-in and may consume API quota.
RUN_LIVE_LLM_TESTS=0
