# Copy this file to .env and fill in values locally. Never commit .env.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///data/writing_feedback.db
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_PROVIDER=deepseek
ACTIVE_ANALYZER=spacy
FALLBACK_ANALYZER=basic
SPACY_MODEL=en_core_web_sm
MATTR_WINDOW=50
LOCAL_REPETITION_WINDOW=30
LONG_SENTENCE_THRESHOLD=30
ANALYSIS_CONFIGURATION_VERSION=nlp-config-v0.4.0
# Live integration tests are opt-in and may consume API quota.
RUN_LIVE_LLM_TESTS=0
